+def pool_history_confidence(
+    confidence: torch.Tensor | None,
+    visibility: torch.Tensor | None,
+    patch_size,
+):
+    if confidence is None:
+        return None
+    if confidence.ndim==4: confidence=confidence.unsqueeze(1)
+    if confidence.ndim!=5:
+        raise ValueError(f"history confidence must be 4D/5D, got {tuple(confidence.shape)}")
+    if visibility is None:
+        visibility=torch.ones_like(confidence)
+    elif visibility.ndim==4:
+        visibility=visibility.unsqueeze(1)
+    confidence=pad_for_3d_conv(confidence.float(),patch_size)
+    visibility=pad_for_3d_conv(visibility.float(),patch_size)
+    numerator=torch.nn.functional.avg_pool3d(
+        confidence*visibility,kernel_size=patch_size,stride=patch_size)
+    denominator=torch.nn.functional.avg_pool3d(
+        visibility,kernel_size=patch_size,stride=patch_size)
+    return numerator/denominator.clamp_min(1e-6)
+
