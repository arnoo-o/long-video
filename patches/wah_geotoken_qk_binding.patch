@@ -192,6 +192,14 @@ class HeliosAttnProcessor:
         original_context_length: int = None,
     ) -> torch.Tensor:
         query, key, value = _get_qkv_projections(attn, hidden_states, encoder_hidden_states)
+        binding = getattr(attn, "geotoken_qk_binding", None)
